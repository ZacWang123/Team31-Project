# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string.
# Local dev: mongodb://127.0.0.1:27017/team31
# MongoDB Atlas (production): the connection string from your Atlas cluster
MONGODB_URI=mongodb://127.0.0.1:27017/team31

# Google Sheets - the live copy of Flight Centre's package data export.
# Sheet ID is the long string in the sheet's URL between /d/ and /edit.
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_API_KEY=
# Which tab/range to read - defaults to the whole first sheet if unset.
GOOGLE_SHEET_RANGE=Sheet1

# How often to re-pull the sheet automatically, in minutes. 0 disables the
# timer - you can still trigger a sync manually via POST /api/sync.
SYNC_INTERVAL_MINUTES=10

PORT=4000
