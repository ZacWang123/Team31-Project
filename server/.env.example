# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string.
# Local dev: mongodb://127.0.0.1:27017/team31
# MongoDB Atlas (production): the connection string from your Atlas cluster
MONGODB_URI=mongodb://127.0.0.1:27017/team31

# Google Sheets - the live copy of Flight Centre's package data.
#
# You don't have to set anything here: by default the server reads the
# project's published "app_data" tab (link is in googleSheets.js), no key needed.
#
# To use a different sheet, publish its tab as CSV
#   (Google Sheets > File > Share > Publish to web > pick the tab > CSV)
# and put the link below. Anyone with the link can read it, so only publish a
# tab that has data you're fine with being public (not the supplier/nett rate columns).
# GOOGLE_SHEET_CSV_URL=
#
# Other way (needs an API key): the sheet shared as "Anyone with the link -
# Viewer". Sheet ID is the long string in the sheet's URL between /d/ and /edit.
# If these two are filled in they are used instead of the default link
# (unless GOOGLE_SHEET_CSV_URL is set, which always wins).
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_API_KEY=
# Which tab/range to read (API way only) - defaults to the first sheet if unset.
GOOGLE_SHEET_RANGE="app_data"

# How often to re-pull the sheet automatically, in minutes. 0 disables the
# timer - you can still trigger a sync manually via POST /api/sync.
SYNC_INTERVAL_MINUTES=10

PORT=4000
